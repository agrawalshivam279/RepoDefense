# ==============================================================================
# RepoDefense Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Application Settings
PROJECT_NAME="RepoDefense API"
VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_STR="/api"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL 17 + pgvector (Local Docker Compose: port 5432 / CI: port 5433)
POSTGRES_USER=repouser
POSTGRES_PASSWORD=repopassword
POSTGRES_DB=repodefense
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://repouser:repopassword@localhost:5432/repodefense

# Redis (Local Docker Compose: port 6379 / Upstash Serverless in Production)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Supabase Auth & Managed Cloud Postgres (Production Deployment)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-min-32-chars-long
JWT_ALGORITHM=HS256

# LLM Routing via LiteLLM (FreeLLMAPI Primary Gateway / OpenAI Compatible)
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=your-freellmapi-api-key
LLM_MODEL=openai/auto
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# Frontend Next.js Public Settings (frontend/.env.local or production Vercel env)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Sentry Crash Reporting (Optional)
SENTRY_DSN=
