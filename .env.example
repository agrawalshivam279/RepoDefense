# ==============================================================================
# RepoDefense Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Application Settings
PROJECT_NAME="RepoDefense API"
VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_STR="/api"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL 17 + pgvector (Local Docker Compose)
POSTGRES_USER=repouser
POSTGRES_PASSWORD=repopassword
POSTGRES_DB=repodefense
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://repouser:repopassword@localhost:5432/repodefense

# Redis (Local Docker Compose / Upstash Serverless)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Supabase Auth & Managed Cloud Postgres (Production Deployment)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# LLM Routing via LiteLLM (FreeLLMAPI Primary Provider)
FREELLMAPI_BASE_URL=https://api.freellmapi.com/v1
FREELLMAPI_API_KEY=your-freellmapi-api-key

# Sentry Crash Reporting (Optional)
SENTRY_DSN=
